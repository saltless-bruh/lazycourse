{
  "name": "pi-tutor",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./extensions/tutor/index.ts"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts/*.md"
    ]
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "golden": "vitest run --config vitest.golden.config.ts",
    "cookbooks": "node scripts/run-cookbooks.mjs",
    "upstream-diff": "node scripts/upstream-diff.mjs",
    "skill-evals": "vitest run --config vitest.skilleval.config.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^1.2.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.3.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "neovim": "^5.5.0"
  },
  "engines": {
    "node": ">=22.19"
  }
}
